---
import DocLayout from '../layouts/DocLayout.astro';
import { developerDocumentation } from '../data/documentation';

const legacyRoutes: Record<string, string> = {
  stack: '/developer/architecture#stack',
  architecture: '/developer/architecture#architecture',
  'data-model': '/developer/data-model#data-model',
  routes: '/developer/application-development#routes',
  plugins: '/developer/plugins#plugins',
  themes: '/developer/themes#themes',
  security: '/developer/security#security',
  checklist: '/developer/operations#checklist'
};
---

<DocLayout
  title="开发文档 - SHOPAGG CMS（思普艾格）"
  description="SHOPAGG CMS 多页开发文档，覆盖架构、数据模型、插件、主题、安全、部署与验收。"
  heading="SHOPAGG CMS 开发文档"
  eyebrow="Documentation for developers"
  intro="面向二次开发者、插件作者、主题作者和维护人员。每个技术领域独立成页，方便定位、分享和持续维护。"
  active="developer"
  version="1.3.4"
  modifiedTime="2026-10-29T00:00:00+08:00"
  canonicalPath="/developer"
  navigation={developerDocumentation}
  overview
>
  <div class="docs-overview-intro">
    <h2>开发主题</h2>
    <p>从系统架构开始，按需阅读数据模型、功能扩展、插件、主题、安全与运维章节。</p>
  </div>
  <div class="docs-card-grid">
    {developerDocumentation.map((page, index) => (
      <a href={`/developer/${page.slug}`} class="docs-card">
        <span class="docs-card-index">{String(index + 1).padStart(2, '0')}</span>
        <i class={page.icon}></i>
        <h2>{page.title}</h2>
        <p>{page.summary}</p>
        <span class="docs-card-link">阅读本章 <i class="fas fa-arrow-right"></i></span>
      </a>
    ))}
  </div>
  <div class="docs-start-callout">
    <div><i class="fas fa-code-branch"></i><span><strong>准备参与开发？</strong>先了解请求生命周期、目录结构和核心模块职责。</span></div>
    <a href="/developer/architecture">了解系统架构 <i class="fas fa-arrow-right"></i></a>
  </div>
  <script is:inline define:vars={{ legacyRoutes }}>
    const target = legacyRoutes[decodeURIComponent(window.location.hash.slice(1))];
    if (target) window.location.replace(target);
  </script>
</DocLayout>
