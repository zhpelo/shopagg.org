---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import releases from '../data/releases.json';
import capabilities from '../data/capabilities.json';

const latest = releases[0];
const version = latest.version;
const title = '灯塔 CMS（Lighthouse CMS）- 开源 B2B 官网系统';
const description = '灯塔 CMS 是面向中国工厂与外贸公司的开源 B2B 官网系统。基于 PHP 8.1+ 与 SQLite，自托管、可扩展，提供产品、询盘、内容、主题和插件平台。';
const featureNames = capabilities.groups.flatMap((group) => group.items.map((item) => item.name));
const iconClass = (icon: string) => `fas fa-${icon}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://shopagg.org/#website', url: 'https://shopagg.org/', name: '灯塔 CMS', alternateName: 'Lighthouse CMS', inLanguage: 'zh-CN' },
    { '@type': 'Organization', '@id': 'https://shopagg.org/#organization', name: '灯塔 CMS', alternateName: 'Lighthouse CMS', url: 'https://shopagg.org/', logo: 'https://shopagg.org/assets/images/logo.webp', sameAs: ['https://github.com/zhpelo/shopagg-b2b-website'] },
    { '@type': 'SoftwareApplication', '@id': 'https://shopagg.org/#software', name: '灯塔 CMS', alternateName: 'Lighthouse CMS', applicationCategory: 'BusinessApplication', operatingSystem: 'Linux, Windows, macOS', softwareRequirements: 'PHP 8.1+、SQLite3', softwareVersion: version, license: 'https://github.com/zhpelo/shopagg-b2b-website/blob/main/LICENSE', url: 'https://shopagg.org/', downloadUrl: latest.package.url, codeRepository: 'https://github.com/zhpelo/shopagg-b2b-website', featureList: featureNames, description }
  ]
};
---

<BaseLayout {title} {description} structuredData={structuredData} canonicalPath="/">
  <Header active="home" />
  <main class="oss-home">
    <section class="oss-hero">
      <div class="oss-grid-pattern"></div>
      <div class="container oss-hero-layout">
        <div class="oss-hero-copy">
          <div class="oss-kicker"><span class="status-dot"></span> Open source · MIT License · v{version}</div>
          <h1><span class="hero-title-line">为外贸业务而生</span><br /><span class="accent">开源 B2B CMS</span></h1>
          <p>灯塔 CMS（Lighthouse CMS）把产品展示、内容运营、客户询盘和插件扩展放进一套轻量系统。PHP + SQLite，上传即可运行，数据和代码始终由你掌控。</p>
          <div class="oss-hero-actions">
            <a href="https://github.com/zhpelo/shopagg-b2b-website" target="_blank" rel="noopener" class="btn oss-btn-light"><i class="fab fa-github"></i> 查看 GitHub</a>
            <a href="/usage#install" class="btn oss-btn-ghost"><i class="fas fa-rocket"></i> 开始部署</a>
          </div>
          <div class="oss-trust-row">
            <span><i class="fas fa-check"></i> 无 Composer 依赖</span>
            <span><i class="fas fa-check"></i> 可部署到普通主机</span>
            <span><i class="fas fa-check"></i> 支持二次开发</span>
          </div>
        </div>

        <div class="repo-card" aria-label="灯塔 CMS 项目安装命令">
          <div class="repo-card-head">
            <div class="repo-dots"><span></span><span></span><span></span></div>
            <span><i class="fab fa-github"></i> zhpelo / shopagg-b2b-website</span>
            <span class="repo-public">Public</span>
          </div>
          <div class="repo-card-body">
            <div class="repo-branch"><span><i class="fas fa-code-branch"></i> main</span><span>PHP</span></div>
            <div class="repo-file-list">
              <div><i class="fas fa-folder"></i><span>app</span><small>核心 MVC 与插件运行时</small></div>
              <div><i class="fas fa-folder"></i><span>themes</span><small>可替换前台主题</small></div>
              <div><i class="fas fa-folder"></i><span>storage</span><small>SQLite 与运行数据</small></div>
              <div><i class="fas fa-file-code"></i><span>index.php</span><small>应用单入口</small></div>
            </div>
            <div class="install-command">
              <span>$</span><code>git clone https://github.com/zhpelo/shopagg-b2b-website.git</code>
              <button type="button" onclick="copyInstallCommand()" aria-label="复制安装命令"><i class="far fa-copy"></i></button>
            </div>
            <div class="repo-release"><span><i class="fas fa-tag"></i> Latest release</span><strong>v{version}</strong><a href="/releases">全部版本 <i class="fas fa-arrow-right"></i></a></div>
          </div>
        </div>
      </div>
    </section>

    <section class="project-facts" aria-label="项目技术信息">
      <div class="container project-facts-grid">
        <a href="/releases"><span>Current stable</span><strong>v{version}</strong></a>
        <div><span>Runtime</span><strong>PHP 8.1+</strong></div>
        <div><span>Database</span><strong>SQLite3</strong></div>
        <a href="https://github.com/zhpelo/shopagg-b2b-website/blob/main/LICENSE" target="_blank" rel="noopener"><span>License</span><strong>MIT</strong></a>
        <a href="/developer#plugins"><span>Plugin API</span><strong>1.0</strong></a>
      </div>
    </section>

    <section class="oss-section" id="capabilities">
      <div class="container">
        <div class="oss-section-heading">
          <div><span class="oss-section-label">Product capabilities</span><h2>一套系统，覆盖官网运营全流程</h2><p>所有能力都有稳定的数据标识和机器可读描述，方便团队选型、文档维护和自动化集成。</p></div>
          <a href="/capabilities" class="text-link">查看完整能力清单 <i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="oss-capability-grid">
          {capabilities.groups.map((group, index) => (
            <a href={`/capabilities#${group.id}`} class:list={['oss-capability-card', { featured: index === 0 || index === 4 }]}>
              <div class="oss-capability-icon"><i class={iconClass(group.icon)}></i></div>
              <div><h3>{group.name}</h3><p>{group.summary}</p><span>{group.items.length} 项稳定能力</span></div>
              <i class="fas fa-arrow-up-right-from-square card-arrow"></i>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="product-showcase" id="demo">
      <div class="container showcase-layout">
        <div class="showcase-copy">
          <span class="oss-section-label">Built for daily operations</span>
          <h2>运营团队能用，开发团队也能扩展</h2>
          <p>后台围绕真实工作流组织：商品与内容统一维护，询盘集中处理，主题、菜单、轮播和插件都拥有明确入口。</p>
          <ul class="oss-check-list">
            <li><i class="fas fa-check"></i><span><strong>运营友好</strong>无需接触代码即可维护产品、文章、案例与页面。</span></li>
            <li><i class="fas fa-check"></i><span><strong>销售可跟进</strong>联系留言和产品询盘进入统一收件箱。</span></li>
            <li><i class="fas fa-check"></i><span><strong>权限清晰</strong>员工账号按模块分配最小权限。</span></li>
          </ul>
          <div class="inline-actions"><a href="https://demo.shopagg.org/admin" target="_blank" rel="noopener" class="btn btn-primary">进入在线演示</a><a href="/usage" class="text-link">阅读使用文档 <i class="fas fa-arrow-right"></i></a></div>
        </div>
        <div class="app-window">
          <div class="app-window-bar"><div><span></span><span></span><span></span></div><span>demo.shopagg.org/admin</span><span class="live-indicator">Live</span></div>
          <img src="https://github.com/user-attachments/assets/86918ca6-dd59-4fde-bacf-eef4dc668460" alt="灯塔 CMS 商品管理后台" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="extension-section" id="extensions">
      <div class="container extension-layout">
        <div class="extension-code-card">
          <div class="code-card-head"><span>plugin.json</span><span>Plugin API 1.0</span></div>
          <pre><code>{`{
  "id": "lighthouse-commerce",
  "name": "Commerce Toolkit",
  "version": "1.0.0",
  "routes": ["routes.php"],
  "events": ["inquiry.created"],
  "services": ["orders", "payments"],
  "jobs": ["sync-catalog"]
}`}</code></pre>
          <div class="code-card-foot"><span><i class="fas fa-circle-check"></i> Manifest validated</span><span>0 runtime scans</span></div>
        </div>
        <div class="extension-copy">
          <span class="oss-section-label light">Extension platform</span>
          <h2>从企业官网，扩展为业务平台</h2>
          <p>插件通过 Manifest 描述能力，在启停时编译缓存。普通请求无需扫描插件目录，同时保留路由、事件、服务和任务等完整扩展面。</p>
          <div class="extension-points">
            <div><i class="fas fa-route"></i><span><strong>路由与 Webhook</strong>注册前台、后台、API 和外部回调。</span></div>
            <div><i class="fas fa-bolt"></i><span><strong>事件与过滤器</strong>响应询盘、内容和系统生命周期。</span></div>
            <div><i class="fas fa-cubes"></i><span><strong>业务服务契约</strong>组合订单、支付、会员与通知能力。</span></div>
            <div><i class="fas fa-clock-rotate-left"></i><span><strong>任务与重试</strong>执行定时、分片任务并保留日志。</span></div>
          </div>
          <a href="/developer#plugins" class="btn oss-btn-light">查看插件开发文档 <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>
    </section>

    <section class="oss-section architecture-section">
      <div class="container architecture-layout">
        <div class="architecture-copy">
          <span class="oss-section-label">Portable by design</span>
          <h2>轻量架构，不绑定运行平台</h2>
          <p>核心程序保持纯 PHP + SQLite。官网本身由 Astro 构建为静态文件，Cloudflare 只是当前部署平台，随时可以迁移到 Nginx、Apache 或其他静态托管。</p>
          <a href="/developer#architecture" class="text-link">查看请求生命周期 <i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="architecture-flow" aria-label="灯塔 CMS 架构流程">
          <div><span>01</span><i class="fas fa-globe"></i><strong>Web Request</strong><small>Apache / Nginx</small></div>
          <i class="fas fa-arrow-right"></i>
          <div><span>02</span><i class="fas fa-code"></i><strong>PHP MVC</strong><small>Router / Controller</small></div>
          <i class="fas fa-arrow-right"></i>
          <div><span>03</span><i class="fas fa-database"></i><strong>SQLite</strong><small>Portable data</small></div>
        </div>
      </div>
    </section>

    <section class="resource-section">
      <div class="container">
        <div class="oss-section-heading centered"><div><span class="oss-section-label">Documentation & data</span><h2>为使用者、开发者和 AI 准备的项目资料</h2><p>同一套事实同时提供网页、Markdown 和 JSON 入口。</p></div></div>
        <div class="resource-grid">
          <a href="/usage" class="resource-card"><i class="fas fa-book-open"></i><div><span>For operators</span><h3>使用文档</h3><p>安装、配置、内容运营、询盘处理和上线检查。</p></div><i class="fas fa-arrow-right"></i></a>
          <a href="/developer" class="resource-card"><i class="fas fa-code"></i><div><span>For developers</span><h3>开发文档</h3><p>MVC、迁移、插件、主题、权限和安全边界。</p></div><i class="fas fa-arrow-right"></i></a>
          <a href="/api/capabilities.json" class="resource-card"><i class="fas fa-code"></i><div><span>For integrations</span><h3>静态 JSON API</h3><p>产品能力、项目资料、兼容性和版本发布数据。</p></div><i class="fas fa-arrow-right"></i></a>
          <a href="/llms.txt" class="resource-card"><i class="fas fa-robot"></i><div><span>For AI</span><h3>llms.txt</h3><p>项目摘要、权威文档入口和完整机器上下文。</p></div><i class="fas fa-arrow-right"></i></a>
        </div>
      </div>
    </section>

    <section class="open-source-cta">
      <div class="container open-source-cta-inner">
        <div><span class="oss-section-label light">Open source, self-hosted</span><h2>把网站、数据和扩展能力掌握在自己手中</h2><p>自由用于个人或商业项目。欢迎 Star、提交 Issue、贡献主题与插件。</p></div>
        <div class="oss-hero-actions"><a href="https://github.com/zhpelo/shopagg-b2b-website" target="_blank" rel="noopener" class="btn oss-btn-light"><i class="fab fa-github"></i> Star on GitHub</a><a href="/usage#install" class="btn oss-btn-ghost">5 分钟开始部署</a></div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline src="/scripts/site.js"></script>
  <script is:inline src="/scripts/home.js"></script>
</BaseLayout>
