---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import releases from '../data/releases.json';

const latest = releases[0];
const title = '版本发布 - SHOPAGG CMS（思普艾格）';
const description = '查看 SHOPAGG CMS 当前稳定版、更新内容、历史发布记录和源码包。版本数据每小时从 GitHub Releases 自动同步。';
const formatDate = (value: string) => new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(value));
const repositoryReleasesUrl = 'https://github.com/zhpelo/shopagg-b2b-website/releases';
---

<BaseLayout {title} {description} canonicalPath="/releases">
  <Header active="releases" />
  <main class="project-page">
    <header class="project-hero compact">
      <div class="container project-hero-grid">
        <div>
          <div class="project-eyebrow"><span class="status-dot"></span> Stable release</div>
          <h1>SHOPAGG CMS v{latest.version}</h1>
          <p>稳定版本直接来自 GitHub Releases。官网每小时自动检查新版本，同步更新内容、下载地址和机器可读 JSON。</p>
          <div class="hero-buttons">
            <a href={latest.release_url} target="_blank" rel="noopener" class="btn btn-primary"><i class="fab fa-github"></i> 查看 Release</a>
            <a href={latest.package.url} class="btn btn-outline"><i class="fas fa-download"></i> 下载源码包</a>
          </div>
        </div>
        <div class="release-current-card">
          <span>Current stable</span><strong>v{latest.version}</strong>
          <dl><div><dt>发布时间</dt><dd>{formatDate(latest.published_at)}</dd></div><div><dt>数据来源</dt><dd>GitHub Releases</dd></div><div><dt>自动同步</dt><dd>每小时</dd></div><div><dt>数据格式</dt><dd>JSON Schema 2</dd></div></dl>
          <a href="/api/releases/latest.json">读取 latest.json <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>
    </header>

    <section class="container release-latest">
      <div class="release-sync-banner">
        <div class="release-sync-icon"><i class="fab fa-github"></i></div>
        <div class="release-sync-copy">
          <span>Automatic release sync</span>
          <h2>GitHub 发布新版本，官网自动跟进</h2>
          <p>定时任务会检查稳定 Release，发现新版本后更新仓库数据并触发 Cloudflare 重新构建。</p>
        </div>
        <div class="release-sync-actions">
          <span><i class="fas fa-arrows-rotate"></i> 每小时检查</span>
          <a href={repositoryReleasesUrl} target="_blank" rel="noopener">打开 GitHub Releases <i class="fas fa-arrow-up-right-from-square"></i></a>
        </div>
      </div>

      <div class="release-notes-card">
        <div class="release-notes-heading">
          <div><span>What's new</span><h2>v{latest.version} 更新内容</h2><p>以下内容来自当前稳定版的 GitHub Release 说明。</p></div>
          <a href={latest.release_url} target="_blank" rel="noopener">查看完整说明 <i class="fas fa-arrow-right"></i></a>
        </div>
        {latest.notes.length > 0 ? (
          <ul class="release-notes-grid">
            {latest.notes.map((note) => <li><i class="fas fa-check"></i><span>{note}</span></li>)}
          </ul>
        ) : (
          <p class="release-notes-empty">该版本未提供摘要，请前往 GitHub 查看完整 Release。</p>
        )}
      </div>
    </section>

    <section class="container release-history">
      <div class="project-section-heading"><div><span>Release history</span><h2>稳定版本记录</h2></div><a href="/api/releases/index.json">完整 JSON <i class="fas fa-code"></i></a></div>
      <div class="release-list">
        {releases.map((release, index) => (
          <article class="release-row">
            <div class="release-node"></div>
            <div class="release-version"><strong>v{release.version}</strong>{index === 0 && <span>Latest</span>}</div>
            <time datetime={release.published_at}>{formatDate(release.published_at)}</time>
            <div class="release-actions"><a href={release.release_url} target="_blank" rel="noopener">说明</a><a href={release.package.url}>源码</a></div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline src="/scripts/site.js"></script>
</BaseLayout>
