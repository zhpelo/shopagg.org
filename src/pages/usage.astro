---
import DocLayout from '../layouts/DocLayout.astro';
import { usageDocumentation } from '../data/documentation';

const legacyRoutes: Record<string, string> = {
  install: '/usage/getting-started#install',
  'first-login': '/usage/getting-started#first-login',
  admin: '/usage/getting-started#admin',
  content: '/usage/product-management#content',
  'content-management': '/usage/content-and-appearance#content-management',
  inbox: '/usage/inquiries#inbox',
  appearance: '/usage/content-and-appearance#appearance',
  apps: '/usage/settings-and-extensions#apps',
  settings: '/usage/settings-and-extensions#settings',
  permissions: '/usage/settings-and-extensions#permissions',
  launch: '/usage/launch-and-faq#launch'
};
---

<DocLayout
  title="使用文档 - 灯塔 CMS（Lighthouse CMS）"
  description="灯塔 CMS 多页使用文档，覆盖安装部署、产品内容、询盘运营、扩展设置和上线检查。"
  heading="灯塔 CMS 使用文档"
  eyebrow="Documentation for operators"
  intro="按工作主题拆分的操作指南。选择一个章节开始阅读，每页都可以通过侧栏和上一篇、下一篇快速切换。"
  active="usage"
  version="1.3.4"
  modifiedTime="2026-10-12T00:00:00+08:00"
  canonicalPath="/usage"
  navigation={usageDocumentation}
  overview
>
  <div class="docs-overview-intro">
    <h2>选择阅读主题</h2>
    <p>面向管理员、运营人员、商品维护人员和销售跟单人员，从安装到日常运营逐步完成网站配置。</p>
  </div>
  <div class="docs-card-grid">
    {usageDocumentation.map((page, index) => (
      <a href={`/usage/${page.slug}`} class="docs-card">
        <span class="docs-card-index">{String(index + 1).padStart(2, '0')}</span>
        <i class={page.icon}></i>
        <h2>{page.title}</h2>
        <p>{page.summary}</p>
        <span class="docs-card-link">阅读本章 <i class="fas fa-arrow-right"></i></span>
      </a>
    ))}
  </div>
  <div class="docs-start-callout">
    <div><i class="fas fa-route"></i><span><strong>第一次使用灯塔 CMS？</strong>从运行环境、安装部署和首次登录开始。</span></div>
    <a href="/usage/getting-started">开始阅读 <i class="fas fa-arrow-right"></i></a>
  </div>
  <script is:inline define:vars={{ legacyRoutes }}>
    const target = legacyRoutes[decodeURIComponent(window.location.hash.slice(1))];
    if (target) window.location.replace(target);
  </script>
</DocLayout>
